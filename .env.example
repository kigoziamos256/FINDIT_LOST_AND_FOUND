# ============================================================
# FindIt — environment template
# Copy this to `.env` when running locally, then fill in real values.
# On Render these are set automatically via render.yaml.
# ============================================================

# Postgres connection string (Render sets this when you attach the DB)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/findit

# A long random string — Render can generate this for you
JWT_SECRET=change-me-to-a-long-random-string

# Leave true on Render free tier (worker runs inside the web process).
# Set to "false" when running a separate worker service (docker-compose / paid Render).
RUN_WORKER=true

# Port the API listens on (Render sets its own automatically)
PORT=3000
